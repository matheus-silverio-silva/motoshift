# Copie para backend/.env e preencha. O .env NAO vai para o git (.gitignore).
# Lido pelo perfil prod (application-prod.properties) quando o backend sobe a
# partir da pasta backend/:
#   mvnw.cmd spring-boot:run "-Dspring-boot.run.profiles=prod"

# --- PostgreSQL (Neon) ---
# Formato JDBC, sem usuario e senha na URL.
SPRING_DATASOURCE_URL=jdbc:postgresql://<host>/<db>?sslmode=require
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# --- Obrigatorias no perfil prod ---
# 32+ caracteres. Trocar invalida os tokens ja emitidos.
JWT_SECRET=
# Origens liberadas no CORS, separadas por virgula.
MOTOSHIFT_CORS_ORIGINS=http://localhost:5000
MOTOSHIFT_FISCAL_CHAVE=
# Pode ficar vazia: sem ela so a sugestao inteligente de turnos nao funciona.
ANTHROPIC_API_KEY=
