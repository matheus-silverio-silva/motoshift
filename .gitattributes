# ============================================================
#  Normalizacao de fim de linha
# ------------------------------------------------------------
#  O repositorio guarda LF; o checkout usa o padrao da plataforma.
#  Sem isto, salvar um arquivo no Windows marca o arquivo inteiro
#  como modificado e enche o diff de ruido.
# ============================================================

* text=auto

# ── Codigo e configuracao: sempre LF no repositorio ──────────
*.java        text eol=lf
*.dart        text eol=lf
*.kt          text eol=lf
*.kts         text eol=lf
*.gradle      text eol=lf
*.properties  text eol=lf
*.xml         text eol=lf
*.yaml        text eol=lf
*.yml         text eol=lf
*.json        text eol=lf
*.md          text eol=lf
*.txt         text eol=lf
*.html        text eol=lf
*.css         text eol=lf
*.js          text eol=lf
*.sql         text eol=lf
*.sh          text eol=lf
# Gerados pelo `flutter pub get` no desktop. Sem eol=lf explicito eles caem no
# `text=auto` acima, nascem CRLF na arvore de trabalho e ficam permanentemente
# "modificados" no git status — os tres reapareciam a cada pub get.
*.cmake       text eol=lf
*.cc          text eol=lf
*.swift       text eol=lf
Dockerfile    text eol=lf
.dockerignore text eol=lf
.gitignore    text eol=lf
gradlew       text eol=lf
mvnw          text eol=lf

# ── Patches: nunca normalizar ────────────────────────────────
#  Um .patch carrega o fim de linha dos arquivos que ele altera.
#  Converter para LF faz o patch deixar de aplicar.
*.patch       -text
*.diff        -text

# ── Scripts do Windows precisam de CRLF ──────────────────────
*.bat         text eol=crlf
*.cmd         text eol=crlf
*.ps1         text eol=crlf
gradlew.bat   text eol=crlf
mvnw.cmd      text eol=crlf

# ── Binarios: nunca converter ────────────────────────────────
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.webp   binary
*.pdf    binary
*.jar    binary
*.war    binary
*.zip    binary
*.ttf    binary
*.otf    binary
*.woff   binary
*.woff2  binary
*.keystore binary
*.jks    binary
